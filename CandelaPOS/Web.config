<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<!--
      Use a dedicated least-privilege SQL login for the POS API.
      DO NOT use sa / lumensoft2003.
      Required permissions: SELECT on masters, INSERT/UPDATE on tblSales/tblSalesLineItems/
      tblShopProductInventory/tblSalesCashTenders, INSERT on tblPOSRegisteredDevices.
    -->
		<add name="CON_STR" connectionString="Password=lumensoft2003;Persist Security Info=True;User ID=sa;Initial Catalog=Candela;Data Source=ho;Pooling=true;Max Pool Size=20" providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<!-- Secrets (Jwt:Secret, and any per-site overrides) belong in
	     App_Data\secrets.config, which is git-ignored and never served by IIS.
	     Keys in that file override the ones below. The file is optional, so
	     nothing breaks if it is absent. -->
	<appSettings file="App_Data\secrets.config">
		<!-- Absolute path to Candela's Reports folder (ends with \). Used to locate RDLC files
         for RDLC-based invoice printing (matches the invoice type in tblComputerList). -->
		<add key="CandelaReportPath" value="D:\candela\5990\CandelaRMS\Candela\Reports\"/>
		<!-- HMAC-SHA256 signing key for JWT — minimum 32 chars, keep secret -->
		<add key="Jwt:Secret" value="CandelaPOS@2026#SecretKey!XYZ789_lumen"/>
		<!-- JWT lifetime in hours -->
		<add key="Jwt:ExpiryHours" value="24"/>
		<!-- Issuer claim -->
		<add key="Jwt:Issuer" value="CandelaPOS"/>
		<!-- Rolling request/error log. Written to App_Data\logs (never served by IIS).
		     Set Logging:Directory to move it off the app folder on a shop till. -->
		<add key="Logging:RetentionDays" value="14"/>
		<!-- Comma-separated origins allowed to call this API. Must include the URL the
		     tablet app is served from, e.g. http://shop-server:8080 — without it the
		     browser blocks every response. Falls back to localhost dev ports. -->
		<add key="Cors:AllowedOrigins" value=""/>
		<!-- Printer targets the SSRF guard should permit beyond the local network.
		     Normally left empty. -->
		<add key="Printing:AllowedHosts" value=""/>
	</appSettings>

	<system.web>
		<compilation debug="true" targetFramework="4.8"/>
		<httpRuntime targetFramework="4.8" maxRequestLength="4096" executionTimeout="120"/>
		<authentication mode="None"/>
	</system.web>

	<system.webServer>
		<validation validateIntegratedModeConfiguration="false"/>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0"/>
			<remove name="OPTIONSVerbHandler"/>
			<remove name="TRACEVerbHandler"/>
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0"/>
		</handlers>
	</system.webServer>

	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="EnvDTE" publicKeyToken="B03F5F7F11D50A3A" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.SqlServer.Types" publicKeyToken="89845DCD8080CC91" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-14.0.0.0" newVersion="14.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Cors" publicKeyToken="31bf3856ad364e35" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-5.2.7.0" newVersion="5.2.7.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>
