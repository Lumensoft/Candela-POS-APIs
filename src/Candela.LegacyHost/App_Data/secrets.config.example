<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy to  App_Data\secrets.config  on each server and fill in real values.
  That file is git-ignored. Keys here override the ones in Web.config.

  Generate a signing key (PowerShell):
    [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
-->
<appSettings>
  <add key="Jwt:Secret" value="REPLACE-WITH-A-FRESH-48-CHAR-RANDOM-KEY" />
  <add key="Cors:AllowedOrigins" value="http://shop-server:8080" />
</appSettings>
